name: Bug report
description: Report a reproducible software defect without personal recordings.
title: "[Bug]: "
labels: [bug]
body:
  - type: markdown
    attributes:
      value: Do not upload identifiable videos or restricted dataset files.
  - type: input
    id: environment
    attributes:
      label: Environment
      description: OS, Python version, CPU/GPU, and browser
    validations:
      required: true
  - type: textarea
    id: steps
    attributes:
      label: Reproduction steps
    validations:
      required: true
  - type: textarea
    id: expected
    attributes:
      label: Expected behavior
    validations:
      required: true
  - type: textarea
    id: actual
    attributes:
      label: Actual behavior and sanitized logs
    validations:
      required: true
  - type: checkboxes
    id: checks
    attributes:
      label: Checklist
      options:
        - label: I removed personal data and private filesystem paths.
          required: true
        - label: I ran the unit tests and searched existing issues.
          required: true
